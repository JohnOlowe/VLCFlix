# Credentials
.secrets/
.git-credentials
.netrc
.env
.ssh/
*.pem
*.key
id_ed25519*
.gitconfig

# Built binaries are never committed. The Windows executable is cross-compiled by
# scripts/build-win-native.sh and left in native/releases/ for handing out; it is
# 5.5 MB of machine code that a fresh clone should build rather than receive.
release/
native/releases/
*.exe
*.dll
*.o
*.res.o

# Build and cache output
.cache/
.venv/
node_modules/
dist/
build/
out/
target/
__pycache__/

# Runtime state and generated artwork (recreated by the scanner)
data/
media/

# The demo clips in samples/ ARE committed (~2 MB) so a fresh clone has
# something to play. They are regenerable with `npm run demo`.
