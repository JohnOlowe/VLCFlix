   ],
   "icons": {
      "128": "bitmaps/logo-128-nooutline.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Video DownloadHelper Pro",
   "optional_permissions": [
      "browsingData",
      "downloads.open"
   ],
   "permissions": [
      "tabs",
      "offscreen",
      "downloads",
      "sidePanel",
      "webRequest",
      "webNavigation",
      "scripting",
      "declarativeNetRequest",
      "storage",
      "notifications",
      "contextMenus",
      "unlimitedStorage"
   ],
   "side_panel": {
      "default_icon": {
         "128": "bitmaps/logo-128-color.png"
      },
      "default_path": "/content/sidebar.html",
