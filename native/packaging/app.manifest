<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest for VLCFlix Studio.

  This file caused "The application has failed to start because its side-by-side
  configuration is incorrect" on a real Windows machine, so the rules it follows now
  are written down here:

  * Only elements and attributes that are in Microsoft's manifest schema are used.
    The previous version carried a `description` ATTRIBUTE on assemblyIdentity. It is
    not in the schema (a description is a child element), Windows' side-by-side parser
    rejects the whole manifest for it, and the process never starts. Wine does not
    validate manifests, which is why the bug survived every test on this machine.

  * There are no <dependency> elements at all. Nothing here imports comctl32.dll, and
    a dependent assembly is the only thing side-by-side has to resolve. With none, a
    "side-by-side configuration is incorrect" failure has nothing left to be about.

  * A comment may not contain a double hyphen. scripts/check-win-manifest.py enforces
    that, the attribute whitelist, the element order and the embedded bytes, and the
    build refuses to ship a manifest that fails it.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="VLCFlixStudio.Desktop"
      version="2.0.1.0"
      processorArchitecture="*" />
  <description>VLCFlix Studio - native C++ media library and player</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11. Not an upgrade path: VLCFlix 1.x keeps whatever it has. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
